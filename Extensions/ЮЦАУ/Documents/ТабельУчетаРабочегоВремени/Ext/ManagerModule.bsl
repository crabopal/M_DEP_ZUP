Функция юцау_ДолжностьОсновногоСотрудника(ФизическоеЛицо, Организация, ДатаСведений) Экспорт
	
	Должности = юцау_ДолжностиОсновныхСотрудников(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ФизическоеЛицо), Организация, ДатаСведений);
	Должность = Должности.Получить(ФизическоеЛицо);
	Если Не ЗначениеЗаполнено(Должность) Тогда
		Должность = Справочники.Должности.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Должность;
	
КонецФункции

Функция юцау_ДолжностиОсновныхСотрудников(ФизическиеЛица, Организация, ДатаСведений)
	
	ДолжностиФизическихЛиц = Новый Соответствие;
	
	Если ФизическиеЛица.Количество() = 0 Или Не ЗначениеЗаполнено(Организация) Тогда
		Возврат ДолжностиФизическихЛиц;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаСведений) Тогда
		ДатаСведений = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	КадровыйУчет.СоздатьВТОсновныеСотрудникиФизическихЛиц(
		Запрос.МенеджерВременныхТаблиц, Истина, ФизическиеЛица, Организация, ДатаСведений);
	
	Если Не ЗарплатаКадры.ВТСодержитСтроки(Запрос.МенеджерВременныхТаблиц, "ВТОсновныеСотрудникиФизическихЛиц") Тогда
		Возврат ДолжностиФизическихЛиц;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ДатаАктуальности", ДатаСведений);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Сотрудники.Сотрудник КАК Сотрудник,
		|	&ДатаАктуальности КАК Период
		|ПОМЕСТИТЬ ВТСотрудники
		|ИЗ
		|	ВТОсновныеСотрудникиФизическихЛиц КАК Сотрудники";
	Запрос.Выполнить();
	
	ОписательВременныхТаблиц = КадровыйУчет.ОписательВременныхТаблицДляСоздатьВТКадровыеДанныеСотрудников(
		Запрос.МенеджерВременныхТаблиц, "ВТСотрудники");
	КадровыйУчет.СоздатьВТКадровыеДанныеСотрудников(ОписательВременныхТаблиц, Истина, "Должность");
	
	Если Не ЗарплатаКадры.ВТСодержитСтроки(Запрос.МенеджерВременныхТаблиц, "ВТКадровыеДанныеСотрудников") Тогда
		Возврат ДолжностиФизическихЛиц;
	КонецЕсли;
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	КадровыеДанныеСотрудников.Должность КАК Должность
		|ИЗ
		|	ВТОсновныеСотрудникиФизическихЛиц КАК Сотрудники
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТКадровыеДанныеСотрудников КАК КадровыеДанныеСотрудников
		|		ПО Сотрудники.Сотрудник = КадровыеДанныеСотрудников.Сотрудник";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДолжностиФизическихЛиц.Вставить(Выборка.ФизическоеЛицо, Выборка.Должность);
	КонецЦикла;
	
	Возврат ДолжностиФизическихЛиц;
	
КонецФункции

Функция юцау_КлючДолжностиСогласовавшего(Организация, ДатаСведений)
	
	ИдентификаторОрганизации = "";
	Если ЗначениеЗаполнено(Организация) Тогда
		ИдентификаторОрганизации = Строка(Организация.УникальныйИдентификатор());
	КонецЕсли;
	
	Возврат ИдентификаторОрганизации + "|" + Формат(ДатаСведений, "ДФ=yyyyMMddHHmmss");
	
КонецФункции

Функция юцау_ДолжностьСогласовавшегоИзКадровогоУчета(ДолжностиПоГруппам, Организация, ДатаСведений, ФизическоеЛицо)
	
	ДолжностиЛиц = ДолжностиПоГруппам.Получить(юцау_КлючДолжностиСогласовавшего(Организация, ДатаСведений));
	Если ДолжностиЛиц = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Должность = ДолжностиЛиц.Получить(ФизическоеЛицо);
	Если Не ЗначениеЗаполнено(Должность) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Должность;
	
КонецФункции
