Процедура юцау_ЗаполнитьДанныеСогласовавшего(ДанныеДокументов)
	
	МассивСсылок = Новый Массив;
	Для Каждого ЭлементДанных Из ДанныеДокументов Цикл
		МассивСсылок.Добавить(ЭлементДанных.Ключ);
		ЭлементДанных.Значение.ДолжностьСогласовавшего = "";
		ЭлементДанных.Значение.ФИОСогласовавшего = "";
	КонецЦикла;
	
	Если МассивСсылок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// +++ 1 бит Балицкий В.В. 11.24.2026
	// РеквизитыДокументов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
	// 	МассивСсылок, "бит_Согласовал,бит_ДолжностьСогласовавшего");
	РеквизитыДокументов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
		МассивСсылок, "бит_Согласовал,Организация,Дата");
	// --- 1 бит Балицкий В.В. 11.24.2026
	
	УникальныеЛица = Новый Соответствие;
	ГруппыДолжностей = Новый Соответствие;
	Для Каждого ЭлементРеквизитов Из РеквизитыДокументов Цикл
		Согласовал = ЭлементРеквизитов.Значение.бит_Согласовал;
		Если Не ЗначениеЗаполнено(Согласовал) Тогда
			Продолжить;
		КонецЕсли;
		
		УникальныеЛица.Вставить(Согласовал, Истина);
		
		Организация = ЭлементРеквизитов.Значение.Организация;
		ДатаСведений = ЭлементРеквизитов.Значение.Дата;
		КлючГруппы = юцау_КлючДолжностиСогласовавшего(Организация, ДатаСведений);
		Группа = ГруппыДолжностей.Получить(КлючГруппы);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура("Организация, Дата, Лица", Организация, ДатаСведений, Новый Массив);
			ГруппыДолжностей.Вставить(КлючГруппы, Группа);
		КонецЕсли;
		Если Группа.Лица.Найти(Согласовал) = Неопределено Тогда
			Группа.Лица.Добавить(Согласовал);
		КонецЕсли;
	КонецЦикла;
	
	ДолжностиПоГруппам = Новый Соответствие;
	Для Каждого ЭлементГруппы Из ГруппыДолжностей Цикл
		Группа = ЭлементГруппы.Значение;
		ДолжностиПоГруппам.Вставить(
			ЭлементГруппы.Ключ,
			юцау_ДолжностиОсновныхСотрудников(Группа.Лица, Группа.Организация, Группа.Дата));
	КонецЦикла;
	
	ИОФамилияПоЛицам = Новый Соответствие;
	Если УникальныеЛица.Количество() > 0 Тогда
		МассивЛиц = Новый Массив;
		Для Каждого ЭлементЛица Из УникальныеЛица Цикл
			МассивЛиц.Добавить(ЭлементЛица.Ключ);
		КонецЦикла;
		
		КадровыеДанныеЛиц = КадровыйУчет.КадровыеДанныеФизическихЛиц(Истина, МассивЛиц, "ИОФамилия");
		Для Каждого СтрокаДанных Из КадровыеДанныеЛиц Цикл
			ИОФамилияПоЛицам.Вставить(СтрокаДанных.ФизическоеЛицо, СтрокаДанных.ИОФамилия);
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого ЭлементРеквизитов Из РеквизитыДокументов Цикл
		ДанныеДокумента = ДанныеДокументов[ЭлементРеквизитов.Ключ];
		Если ДанныеДокумента = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Согласовал = ЭлементРеквизитов.Значение.бит_Согласовал;
		Если Не ЗначениеЗаполнено(Согласовал) Тогда
			Продолжить;
		КонецЕсли;
		
		ФИОСогласовавшего = ИОФамилияПоЛицам[Согласовал];
		Если ФИОСогласовавшего = Неопределено Тогда
			ФИОСогласовавшего = "";
		КонецЕсли;
		
		ДанныеДокумента.ФИОСогласовавшего = ФИОСогласовавшего;
		// +++ 1 бит Балицкий В.В. 11.24.2026
		// ДанныеДокумента.ДолжностьСогласовавшего = ЭлементРеквизитов.Значение.бит_ДолжностьСогласовавшего;
		ДанныеДокумента.ДолжностьСогласовавшего = юцау_ДолжностьСогласовавшегоИзКадровогоУчета(
			ДолжностиПоГруппам,
			ЭлементРеквизитов.Значение.Организация,
			ЭлементРеквизитов.Значение.Дата,
			Согласовал);
		// --- 1 бит Балицкий В.В. 11.24.2026
	КонецЦикла;
	
КонецПроцедуры
