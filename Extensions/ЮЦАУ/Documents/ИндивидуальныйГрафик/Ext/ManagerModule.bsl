
&После("ДобавитьКомандыПечати")
Процедура юцау_ДобавитьКомандыПечати(КомандыПечати)   //Ширшов П.С.
	
	// График сменности 
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Обработчик = "УправлениеПечатьюБЗККлиент.ВыполнитьКомандуПечати";
	КомандаПечати.Идентификатор = "ПФ_MXL_ГрафикСменности";
	КомандаПечати.Представление = НСтр("ru = 'График сменности'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	КомандаПечати.ДополнительныеПараметры.Вставить("ПутьКПодписантам", "ФизическиеЛица.ФизическоеЛицо");
		
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,
		"ПФ_MXL_ГрафикСменности") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ПФ_MXL_ГрафикСменности",
			"График сменности",
			СформироватьПечатнуюФормуГрафикСменности(МассивОбъектов,
				ОбъектыПечати));
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьПечатнуюФормуГрафикСменности(МассивОбъектов, ОбъектыПечати)
	
	НастройкиПечатныхФорм = ЗарплатаКадры.НастройкиПечатныхФорм();
	
	ВидВремениВыходной = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.ВидыИспользованияРабочегоВремени.ВыходныеДни");
	ВидВремениОплачиваемыеНерабочиеДни =
		ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.ВидыИспользованияРабочегоВремени.ОплачиваемыеНерабочиеДни");
	ВидВремениНочныеЧасы = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.ВидыИспользованияРабочегоВремени.РаботаНочныеЧасы");
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	
	ТабличныйДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ГРАФИК_СМЕННОСТИ";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ИндивидуальныйГрафик.ПФ_MXL_ГрафикСменности");
	
	РезультатыЗапросаПоДокументам = СформироватьЗапросДляПечати(МассивОбъектов);
	
	КоличествоРезультатов = РезультатыЗапросаПоДокументам.Количество();
	
	ВыборкаПоДаннымДокументов = РезультатыЗапросаПоДокументам[КоличествоРезультатов - 2].Выбрать();
	
	ДанныеДокументов = Новый Соответствие;
	
	Пока ВыборкаПоДаннымДокументов.Следующий() Цикл
		
		ДанныеДокумента = Новый Структура("Дата, ДатаНачалаПериода, ДатаОкончанияПериода, Номер, Организация, ОрганизацияНаименование, Подразделение, ПодразделениеНаименование"
			+ ",Ответственный,Согласовал,Профсоюз");
		ЗаполнитьЗначенияСвойств(ДанныеДокумента, ВыборкаПоДаннымДокументов);
		ДанныеДокументов.Вставить(ВыборкаПоДаннымДокументов.Ссылка, ДанныеДокумента);
		
	КонецЦикла;	
	
	ВыборкаДанныхОВремени = РезультатыЗапросаПоДокументам[КоличествоРезультатов - 1].Выбрать();
	
	ТекущийЛист = Новый ТабличныйДокумент;
	ТекущийЛист.АвтоМасштаб = Истина;
	ТекущийЛист.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;	
	Пока ВыборкаДанныхОВремени.СледующийПоЗначениюПоля("Ссылка") Цикл
		
		Если ТабличныйДокумент.ВысотаТаблицы > 0 Тогда
			ТекущийЛист = Новый ТабличныйДокумент;
			ТекущийЛист.АвтоМасштаб = Истина;
			ТекущийЛист.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
			
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли; 
		
		ДанныеДокумента = ДанныеДокументов[ВыборкаДанныхОВремени.Ссылка];
		
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
		
		ДанныеОтветственныхЛиц = ЗарплатаКадры.ОтветственныеЛицаОрганизации(ДанныеДокумента.Организация, "Руководитель,ДолжностьРуководителя", ТекущаяДатаСеанса());
		
		ДанныеСогласовал = КадровыйУчет.КадровыеДанныеСотрудников(Ложь, ДанныеДокумента.Согласовал, "Должность", ДанныеДокумента.ДатаНачалаПериода)[0]; 
			Если ДанныеДокумента.Профсоюз <> Справочники.Сотрудники.ПустаяСсылка() Тогда  
	ДанныеПрофсоюз = КадровыйУчет.КадровыеДанныеСотрудников(Ложь, ДанныеДокумента.Профсоюз, "Должность", ДанныеДокумента.ДатаНачалаПериода)[0]; 
		 КонецЕсли;
		СтруктураШапки = Новый Структура("ДатаЗаполнения,НомерДокумента,ПредставлениеМесяца,ОрганизацияНаименование,ПодразделениеНаименование,ДолжностьРуководителя,ФИОРуководителя,ДолжностьСогласовано,ФИОСогласовано,ФИОПрофсоюз");
		
		СтруктураШапки.ДолжностьРуководителя = ДанныеОтветственныхЛиц.ДолжностьРуководителя;
		СтруктураШапки.ФИОРуководителя = ФизическиеЛицаЗарплатаКадрыКлиентСервер.ФамилияИнициалы(ДанныеОтветственныхЛиц.Руководитель);
		
		СтруктураШапки.ДолжностьСогласовано = ДанныеСогласовал.Должность;
		СтруктураШапки.ФИОСогласовано = ФизическиеЛицаЗарплатаКадрыКлиентСервер.ФамилияИнициалы(ДанныеДокумента.Согласовал.ФизическоеЛицо);             
		Если ДанныеДокумента.Профсоюз <> Справочники.Сотрудники.ПустаяСсылка() Тогда  
        	СтруктураШапки.ФИОПрофсоюз = ФизическиеЛицаЗарплатаКадрыКлиентСервер.ФамилияИнициалы(ДанныеДокумента.Профсоюз.ФизическоеЛицо);
		КонецЕсли;
		
		СтруктураШапки.ДатаЗаполнения = Формат(ДанныеДокумента.Дата, "ДФ=dd.MM.yyyy");
		СтруктураШапки.НомерДокумента = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДанныеДокумента.Номер, Истина, Истина);

		СтруктураШапки.ПредставлениеМесяца = Формат(ДанныеДокумента.ДатаНачалаПериода,"ДФ='ММММ yyyy'") + " г.";
		
		Если НастройкиПечатныхФорм.ВыводитьПолнуюИерархиюПодразделений И ЗначениеЗаполнено(ДанныеДокумента.Подразделение) Тогда
			СтруктураШапки.ПодразделениеНаименование = ДанныеДокумента.Подразделение.ПолноеНаименование();
		Иначе
			СтруктураШапки.ПодразделениеНаименование = ДанныеДокумента.ПодразделениеНаименование;
		КонецЕсли;
		
		ОбластьШапка.Параметры.Заполнить(СтруктураШапки);
		
		ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
		
		ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");

		ОбластьПримечание = Макет.ПолучитьОбласть("Примечание");

		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ТабличныйДокумент.Вывести(ОбластьШапка);
		ТекущийЛист.Вывести(ОбластьШапка);
		ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
		ТекущийЛист.Вывести(ОбластьШапкаТаблицы);

		НомерСотрудника = 0;
		ОбластьДанныеОВремени = Макет.ПолучитьОбласть("Строка");
		
		ИменаПараметровДанныеОВремени = "Сотрудник,ТабельныйНомер,НомерПП,КолВоДнейПредставление,КолВоЧасовПредставление";
		
		Пока ВыборкаДанныхОВремени.СледующийПоЗначениюПоля("Сотрудник") Цикл
			Пока ВыборкаДанныхОВремени.СледующийПоЗначениюПоля("Должность") Цикл
			
				ДнейЗаМесяц = 0;
				ВыходныхДнейЗаМесяц = 0;
				ЧасовЗаМесяц = 0;
				НочныхЧасовЗаМесяц = 0;
				НомерСотрудника = НомерСотрудника + 1;
				ОбластьДанныеОВремениПараметры = Новый Структура(ИменаПараметровДанныеОВремени);
				
				Если НомерСотрудника > 1 Тогда
					ВывестиДанныеСотрудникаВКоллекцию(ТабличныйДокумент, ТекущийЛист, ОбластьДанныеОВремени, ОбластьШапкаТаблицы);
					ОбластьДанныеОВремени = Макет.ПолучитьОбласть("Строка");
				КонецЕсли;
				
				Если НастройкиПечатныхФорм.ВыводитьПолныеФИОВСписочныхПечатныхФормах Тогда
					ФИО = ВыборкаДанныхОВремени.ФИОПолные;
				Иначе
					ФИО = ВыборкаДанныхОВремени.ФамилияИО;
				КонецЕсли;
				
				ОбластьДанныеОВремениПараметры.Сотрудник = ФИО + "
														|(" + ВыборкаДанныхОВремени.Должность + ")";
														
				ОбластьДанныеОВремениПараметры.ТабельныйНомер = ВыборкаДанныхОВремени.ТабельныйНомер;
				
				ОбластьДанныеОВремениПараметры.НомерПП = НомерСотрудника;
				
				ОтклоненияПоСотруднику = Новый ТаблицаЗначений;
				ОтклоненияПоСотруднику.Колонки.Добавить("ВидВремени");
				ОтклоненияПоСотруднику.Колонки.Добавить("БуквенныйКод");
				ОтклоненияПоСотруднику.Колонки.Добавить("Часов");
				ОтклоненияПоСотруднику.Колонки.Добавить("Дней");
				
				Пока ВыборкаДанныхОВремени.СледующийПоЗначениюПоля("Дата") Цикл 
					ПредставлениеВидовВремени = "";
					ЧасыПоВидамВремениСтрока = "";
					
					КоличествоЗаписейНаДату = 0;
					ЭтоОтклонение = Ложь;
					
					РабочийДень = Ложь;
					Пока ВыборкаДанныхОВремени.Следующий() Цикл
						Если ВыборкаДанныхОВремени.РабочееВремя 
							И ВыборкаДанныхОВремени.ВидВремени <> ВидВремениНочныеЧасы
							И ВыборкаДанныхОВремени.ВидВремени <> ВидВремениОплачиваемыеНерабочиеДни
							И ВыборкаДанныхОВремени.ОсновноеВремя <> Справочники.ВидыИспользованияРабочегоВремени.ПустаяСсылка() Тогда
							ДнейЗаМесяц = ДнейЗаМесяц + 1;
						КонецЕсли;
						
						ПредставлениеВидовВремени = ПредставлениеВидовВремени + "/"+  ВыборкаДанныхОВремени.БуквенныйКод;
						
						Если Не ВыборкаДанныхОВремени.Целосменное Тогда
							ЧасыПоВидамВремениСтрока = ЧасыПоВидамВремениСтрока +  "/" + Формат(ВыборкаДанныхОВремени.Часов, "ЧГ=");
						КонецЕсли;
						
						Если ВыборкаДанныхОВремени.ВидВремени = ВидВремениВыходной Тогда
							ВыходныхДнейЗаМесяц = ВыходныхДнейЗаМесяц + 1;
						КонецЕсли;
						
						КоличествоЗаписейНаДату = КоличествоЗаписейНаДату + 1;
					КонецЦикла;
					
					Если КоличествоЗаписейНаДату = 1 И ЭтоОтклонение Тогда  
						ЧасыПоВидамВремениСтрока = "";
					КонецЕсли;
					Если ВыборкаДанныхОВремени.ВидВремени = ВидВремениНочныеЧасы Тогда     
						НочныхЧасовЗаМесяц = НочныхЧасовЗаМесяц + ВыборкаДанныхОВремени.Часов;
					КонецЕсли;
					
					ЧасовЗаМесяц = ЧасовЗаМесяц + ВыборкаДанныхОВремени.Часов;
					
					НомерДня = День(ВыборкаДанныхОВремени.Дата);
					
					ОбластьДанныеОВремениПараметры.Вставить("Символ" + НомерДня, Сред(ПредставлениеВидовВремени, 2));
					ОбластьДанныеОВремениПараметры.Вставить("ДополнительноеЗначение"+ НомерДня, Сред(ЧасыПоВидамВремениСтрока, 2));
				КонецЦикла;
				
				ОбластьДанныеОВремениПараметры.КолВоДнейПредставление = Строка(ДнейЗаМесяц) + " / " + Строка(ВыходныхДнейЗаМесяц);
				ОбластьДанныеОВремениПараметры.КолВоЧасовПредставление = Строка(ЧасовЗаМесяц) + " / " + ?(НочныхЧасовЗаМесяц > 0, Строка(НочныхЧасовЗаМесяц), "");
				
				ОтклоненияПоСотруднику.Свернуть("ВидВремени, БуквенныйКод", "Дней, Часов");
				
				ОбластьДанныеОВремени.Параметры.Заполнить(ОбластьДанныеОВремениПараметры);
			КонецЦикла;
		КонецЦикла;
		
		
		ОбластьПодвал.Параметры.Заполнить(ДанныеДокумента);
 		Если НомерСотрудника > 0 Тогда
			ВывестиДанныеСотрудникаВКоллекцию(ТабличныйДокумент, ТекущийЛист, ОбластьДанныеОВремени, ОбластьШапкаТаблицы, ОбластьПодвал, ОбластьПримечание);
		Иначе
			ТабличныйДокумент.Вывести(ОбластьПодвал);
			ТекущийЛист.Вывести(ОбластьПодвал);
			ТабличныйДокумент.Вывести(ОбластьПримечание);
			ТекущийЛист.Вывести(ОбластьПримечание);

		КонецЕсли;
		
		ТекущийЛист.Вывести(ОбластьПримечание);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ВыборкаДанныхОВремени.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция СформироватьЗапросДляПечати(МассивОбъектов)
	
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ИндивидуальныйГрафикДанныеОВремени.Сотрудник КАК Сотрудник,
		|	ИндивидуальныйГрафикДанныеОВремени.Ссылка КАК Ссылка,
		|	МИНИМУМ(ИндивидуальныйГрафикДанныеОВремени.НомерСтроки) КАК НомерСтроки
		|ПОМЕСТИТЬ ВТПорядокСотрудниковВДокументах
		|ИЗ
		|	Документ.ИндивидуальныйГрафик.ДанныеОВремени КАК ИндивидуальныйГрафикДанныеОВремени
		|ГДЕ
		|	ИндивидуальныйГрафикДанныеОВремени.Ссылка В(&МассивОбъектов)
		|
		|СГРУППИРОВАТЬ ПО
		|	ИндивидуальныйГрафикДанныеОВремени.Сотрудник,
		|	ИндивидуальныйГрафикДанныеОВремени.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИндивидуальныйГрафикДанныеОВремени.Ссылка КАК Ссылка,
		|	ИндивидуальныйГрафикДанныеОВремени.Сотрудник КАК Сотрудник,
		|	ИндивидуальныйГрафикДанныеОВремени.Часов1 КАК Часов,
		|	ИндивидуальныйГрафикДанныеОВремени.ВидВремени1 КАК ВидВремени,
		|	НАЧАЛОПЕРИОДА(ИндивидуальныйГрафикДанныеОВремени.Ссылка.ДатаНачалаПериода, МЕСЯЦ) КАК Дата,
		|	ИндивидуальныйГрафикДанныеОВремени.Ссылка.Дата КАК ДатаДокумента,
		|	ИндивидуальныйГрафикДанныеОВремени.НомерСтроки КАК НомерСтроки
		|ПОМЕСТИТЬ ВТДанныеОВремени
		|ИЗ
		|	Документ.ИндивидуальныйГрафик.ДанныеОВремени КАК ИндивидуальныйГрафикДанныеОВремени
		|ГДЕ
		|	ИндивидуальныйГрафикДанныеОВремени.Ссылка В(&МассивОбъектов)
		|	И ИндивидуальныйГрафикДанныеОВремени.ВидВремени1 <> ЗНАЧЕНИЕ(Справочник.ВидыИспользованияРабочегоВремени.ПустаяСсылка)";
	
	ЧастиЗапроса = Новый Массив;
	ЧастиЗапроса.Добавить(ТекстЗапроса);
	
	Для Сч = 2 По 31 Цикл
		ТекстЗапроса = "
		|	ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ИндивидуальныйГрафикДанныеОВремени.Ссылка,
		|	ИндивидуальныйГрафикДанныеОВремени.Сотрудник,
		|	ИндивидуальныйГрафикДанныеОВремени.Часов%1,
		|	ИндивидуальныйГрафикДанныеОВремени.ВидВремени%1,
		|	ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(ИндивидуальныйГрафикДанныеОВремени.Ссылка.ДатаНачалаПериода, МЕСЯЦ), ДЕНЬ, %2),
		|	ИндивидуальныйГрафикДанныеОВремени.Ссылка.Дата КАК ДатаДокумента,
		|	ИндивидуальныйГрафикДанныеОВремени.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	Документ.ИндивидуальныйГрафик.ДанныеОВремени КАК ИндивидуальныйГрафикДанныеОВремени
		|ГДЕ
		|	ИндивидуальныйГрафикДанныеОВремени.Ссылка В(&МассивОбъектов)
