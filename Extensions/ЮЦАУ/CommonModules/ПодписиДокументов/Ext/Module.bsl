Процедура юцау_ЗаполнитьДолжностьСогласовавшегоНаФорме(Форма)
	
	// +++ 1 бит Балицкий В.В. 11.24.2026
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "Объект") Тогда
		Возврат;
	КонецЕсли;
	
	ОбъектФормы = Форма.Объект;
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОбъектФормы, "бит_Согласовал") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОбъектФормы.бит_Согласовал) Или Не ЗначениеЗаполнено(ОбъектФормы.Организация) Тогда
		Возврат;
	КонецЕсли;
	
	Должность = Документы.ТабельУчетаРабочегоВремени.юцау_ДолжностьОсновногоСотрудника(
		ОбъектФормы.бит_Согласовал, ОбъектФормы.Организация, ОбъектФормы.Дата);
	
	Если ОбъектФормы.бит_ДолжностьСогласовавшего = Должность Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Форма.Модифицированность;
	ОбъектФормы.бит_ДолжностьСогласовавшего = Должность;
	Форма.Модифицированность = Модифицированность;
	
	ПодписиДокументовКлиентСервер.УстановитьПредставлениеПодписей(Форма);
	// --- 1 бит Балицкий В.В. 11.24.2026
	
КонецПроцедуры
