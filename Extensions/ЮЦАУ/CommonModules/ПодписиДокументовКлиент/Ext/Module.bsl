&После("ПриИзмененииПодписывающегоЛица")
Процедура юцау_ПриИзмененииПодписывающегоЛица(Форма, ИмяЭлемента, ОписаниеФормыОбъекта = Неопределено, ДатаСведений = Неопределено)
	
	// +++ 1 бит Балицкий В.В. 11.24.2026
	Если Не СтрЗаканчиваетсяНа(ИмяЭлемента, "Подписибит_Согласовал") Тогда
		Возврат;
	КонецЕсли;
	
	ФизическоеЛицо = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.бит_Согласовал");
	Организация = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.Организация");
	Если Не ЗначениеЗаполнено(ФизическоеЛицо) Или Не ЗначениеЗаполнено(Организация) Тогда
		Возврат;
	КонецЕсли;
	
	ДатаДокумента = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Форма, "Объект.Дата");
	// Должность = Документы.ТабельУчетаРабочегоВремени.юцау_ДолжностьОсновногоСотрудника(
	// 	ФизическоеЛицо, Организация, ДатаДокумента);
	Должность = юцау_ПодписиДокументовВызовСервера.юцау_ДолжностьОсновногоСотрудника(
		ФизическоеЛицо, Организация, ДатаДокумента);
	
	ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(Форма, "Объект.бит_ДолжностьСогласовавшего", Должность);
	ПодписиДокументовКлиентСервер.УстановитьПредставлениеПодписей(Форма);
	// --- 1 бит Балицкий В.В. 11.24.2026
	
КонецПроцедуры
