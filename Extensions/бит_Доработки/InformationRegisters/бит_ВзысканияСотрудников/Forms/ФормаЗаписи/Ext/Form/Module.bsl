#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция СледующийНомер(Сотрудник)

	// +++ 1 бит Балицкий В.В. 11.20.2026
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(Регистр.НомерПоПорядку) КАК НомерПоПорядку
	|ИЗ
	|	РегистрСведений.бит_ВзысканияСотрудников КАК Регистр
	|ГДЕ
	|	Регистр.Сотрудник = &Сотрудник";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.НомерПоПорядку) Тогда
		Возврат Выборка.НомерПоПорядку + 1;
	КонецЕсли;

	Возврат 1;
	// --- 1 бит Балицкий В.В. 11.20.2026

КонецФункции

#КонецОбласти
