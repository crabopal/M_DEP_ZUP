				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Статус</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Взыскания.Сотрудник КАК Сотрудник,
	Взыскания.ВидВзыскания КАК ВидВзыскания,
	Взыскания.Дата КАК Дата,
	Взыскания.НомерПриказа КАК НомерПриказа,
	Взыскания.ДатаПриказа КАК ДатаПриказа,
	Взыскания.Комментарий КАК Комментарий,
	ВЫБОР
		КОГДА ДОБАВИТЬКДАТЕ(ВЫБОР
					КОГДА Взыскания.ДатаПриказа = ДАТАВРЕМЯ(1, 1, 1)
						ТОГДА Взыскания.Дата
					ИНАЧЕ Взыскания.ДатаПриказа
				КОНЕЦ, ГОД, 1) &gt; &amp;ТекущаяДата
			ТОГДА "Действует"
		ИНАЧЕ "Снято"
	КОНЕЦ КАК Статус
ИЗ
	РегистрСведений.бит_ВзысканияСотрудников КАК Взыскания
ГДЕ
	(&amp;НачалоПериода = ДАТАВРЕМЯ(1, 1, 1)
			ИЛИ Взыскания.ДатаПриказа &gt;= &amp;НачалоПериода)
	И (&amp;КонецПериода = ДАТАВРЕМЯ(1, 1, 1)
			ИЛИ Взыскания.ДатаПриказа &lt;= &amp;КонецПериода)
{ГДЕ
	Взыскания.Сотрудник.*}</query>
