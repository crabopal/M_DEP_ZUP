					<v8:lang>ru</v8:lang>
					<v8:content>Сумма</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Штрафы.Дата КАК Дата,
	Штрафы.Сотрудник КАК Сотрудник,
	Штрафы.ПунктПДД КАК ПунктПДД,
	Штрафы.Нарушение КАК Нарушение,
	Штрафы.Сумма КАК Сумма
ИЗ
	РегистрСведений.бит_ШтрафыПДД КАК Штрафы
ГДЕ
	(&amp;НачалоПериода = ДАТАВРЕМЯ(1, 1, 1)
			ИЛИ Штрафы.Дата &gt;= &amp;НачалоПериода)
	И (&amp;КонецПериода = ДАТАВРЕМЯ(1, 1, 1)
			ИЛИ Штрафы.Дата &lt;= &amp;КонецПериода)
{ГДЕ
	Штрафы.Сотрудник.*}</query>
	</dataSet>
