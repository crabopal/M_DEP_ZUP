#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// +++ 1 бит Балицкий В.В. 11.20.2026
	бит_ЗаписатьПриЗакрытии = Истина;
	бит_ФизическоеЛицо = Параметры.ФизическоеЛицо;
	Если Параметры.Свойство("Сотрудник") Тогда
		бит_Сотрудник = Параметры.Сотрудник;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(бит_ФизическоеЛицо) Тогда
		ТолькоПросмотр = Истина;
		Возврат;
	КонецЕсли;

	Если Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.бит_ВзысканияСотрудников) Тогда
		ТолькоПросмотр = Истина;
	КонецЕсли;

	ПрочитатьВзыскания();
	УстановитьОформлениеВзысканий();
	// --- 1 бит Балицкий В.В. 11.20.2026

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	// +++ 1 бит Балицкий В.В. 11.20.2026
	Если ЗавершениеРаботы Или ТолькоПросмотр Или Не Модифицированность Или Не бит_ЗаписатьПриЗакрытии Тогда
		Возврат;
	КонецЕсли;

	Если Не ПроверитьЗаполнениеВзысканий() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Попытка
		ЗаписатьВзысканияНаСервере();
	Исключение
		Отказ = Истина;
		ВызватьИсключение;
	КонецПопытки;
	// --- 1 бит Балицкий В.В. 11.20.2026

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыВзыскания

&НаКлиенте
Процедура ВзысканияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	// +++ 1 бит Балицкий В.В. 11.20.2026
	Если Не НоваяСтрока Тогда
		Возврат;
	КонецЕсли;

	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если Не Копирование Тогда
		ТекущиеДанные.Сотрудник = бит_Сотрудник;
		ТекущиеДанные.Статус = "Действует";
	КонецЕсли;
	ТекущиеДанные.НомерПоПорядку = СледующийНомерВзыскания(ТекущиеДанные.Сотрудник);
	Модифицированность = Истина;
	// --- 1 бит Балицкий В.В. 11.20.2026

КонецПроцедуры

&НаКлиенте
Процедура ВзысканияПриИзменении(Элемент)

	// +++ 1 бит Балицкий В.В. 11.20.2026
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.Статус = СтатусВзыскания(ТекущиеДанные.Дата, ТекущиеДанные.ДатаПриказа);
	КонецЕсли;
	Модифицированность = Истина;
	// --- 1 бит Балицкий В.В. 11.20.2026

КонецПроцедуры

&НаКлиенте
Процедура ВзысканияПослеУдаления(Элемент)

	// +++ 1 бит Балицкий В.В. 11.20.2026
	Модифицированность = Истина;
	// --- 1 бит Балицкий В.В. 11.20.2026

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)

	// +++ 1 бит Балицкий В.В. 11.20.2026
	Если Не ТолькоПросмотр И Модифицированность И Не ПроверитьЗаполнениеВзысканий() Тогда
		Возврат;
	КонецЕсли;

	бит_ЗаписатьПриЗакрытии = Истина;
	Закрыть();
	// --- 1 бит Балицкий В.В. 11.20.2026

КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)

	// +++ 1 бит Балицкий В.В. 11.20.2026
	Если ТолькоПросмотр Или Не Модифицированность Тогда
		Возврат;
	КонецЕсли;

	Если Не ПроверитьЗаполнениеВзысканий() Тогда
		Возврат;
	КонецЕсли;

	ЗаписатьВзысканияНаСервере();
	Модифицированность = Ложь;
	// --- 1 бит Балицкий В.В. 11.20.2026

КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)

	// +++ 1 бит Балицкий В.В. 11.20.2026
	бит_ЗаписатьПриЗакрытии = Ложь;
	Модифицированность = Ложь;
	Закрыть();
	// --- 1 бит Балицкий В.В. 11.20.2026

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ПроверитьЗаполнениеВзысканий()

	// +++ 1 бит Балицкий В.В. 11.20.2026
	Заполнено = Истина;
	Для Каждого СтрокаВзыскания Из Взыскания Цикл
		Если Не ЗначениеЗаполнено(СтрокаВзыскания.Сотрудник) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнен сотрудник дисциплинарного взыскания.");
			Заполнено = Ложь;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаВзыскания.ВидВзыскания) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнен вид дисциплинарного взыскания.");
			Заполнено = Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Заполнено;
	// --- 1 бит Балицкий В.В. 11.20.2026

КонецФункции

&НаКлиенте
Функция СледующийНомерВзыскания(Сотрудник)

	// +++ 1 бит Балицкий В.В. 11.20.2026
	МаксимальныйНомер = 0;
	Для Каждого СтрокаВзыскания Из Взыскания Цикл
		Если СтрокаВзыскания.Сотрудник = Сотрудник
			И СтрокаВзыскания.НомерПоПорядку > МаксимальныйНомер Тогда
			МаксимальныйНомер = СтрокаВзыскания.НомерПоПорядку;
		КонецЕсли;
	КонецЦикла;
	Возврат МаксимальныйНомер + 1;
	// --- 1 бит Балицкий В.В. 11.20.2026

КонецФункции

&НаСервереБезКонтекста
Функция СтатусВзыскания(Дата, ДатаПриказа)

	// +++ 1 бит Балицкий В.В. 11.20.2026
	ДатаОснования = Дата;
	Если ЗначениеЗаполнено(ДатаПриказа) Тогда
		ДатаОснования = ДатаПриказа;
	КонецЕсли;

	Если ЗначениеЗаполнено(ДатаОснования)
		И ДобавитьМесяц(ДатаОснования, 12) > НачалоДня(ТекущаяДатаСеанса()) Тогда
		Возврат "Действует";
	КонецЕсли;

	Возврат "Снято";
	// --- 1 бит Балицкий В.В. 11.20.2026

КонецФункции

&НаСервере
Процедура ПрочитатьВзыскания()

	// +++ 1 бит Балицкий В.В. 11.20.2026
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФизическоеЛицо", бит_ФизическоеЛицо);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Взыскания.Сотрудник КАК Сотрудник,
	|	Взыскания.НомерПоПорядку КАК НомерПоПорядку,
	|	Взыскания.ВидВзыскания КАК ВидВзыскания,
	|	Взыскания.Дата КАК Дата,
	|	Взыскания.НомерПриказа КАК НомерПриказа,
	|	Взыскания.ДатаПриказа КАК ДатаПриказа,
	|	Взыскания.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.бит_ВзысканияСотрудников КАК Взыскания
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
	|		ПО Взыскания.Сотрудник = Сотрудники.Ссылка
	|ГДЕ
	|	Сотрудники.ФизическоеЛицо = &ФизическоеЛицо
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сотрудник,
	|	НомерПоПорядку";

	Взыскания.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаВзыскания = Взыскания.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаВзыскания, Выборка);
		СтрокаВзыскания.Статус = СтатусВзыскания(Выборка.Дата, Выборка.ДатаПриказа);
	КонецЦикла;
	Модифицированность = Ложь;
	// --- 1 бит Балицкий В.В. 11.20.2026

КонецПроцедуры

&НаСервере
Процедура УстановитьОформлениеВзысканий()

	// +++ 1 бит Балицкий В.В. 11.20.2026
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОформления.Использование = Истина;
	ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("Взыскания");

	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Взыскания.Статус");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = "Снято";
	ЭлементОтбора.Использование = Истина;
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра(
		"Шрифт", Новый Шрифт(ШрифтыСтиля.ОбычныйШрифтТекста,,,,,, Истина));
	// --- 1 бит Балицкий В.В. 11.20.2026

КонецПроцедуры

&НаСервере
Процедура ЗаписатьВзысканияНаСервере()

	// +++ 1 бит Балицкий В.В. 11.20.2026
	ТаблицаВзысканий = РеквизитФормыВЗначение("Взыскания");

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФизическоеЛицо", бит_ФизическоеЛицо);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сотрудники.Ссылка КАК Сотрудник
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.ФизическоеЛицо = &ФизическоеЛицо";
	СотрудникиКЗаписи = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Сотрудник");

	Для Каждого СтрокаВзыскания Из ТаблицаВзысканий Цикл
		Если ЗначениеЗаполнено(СтрокаВзыскания.Сотрудник)
			И СотрудникиКЗаписи.Найти(СтрокаВзыскания.Сотрудник) = Неопределено Тогда
			СотрудникиКЗаписи.Добавить(СтрокаВзыскания.Сотрудник);
		КонецЕсли;
	КонецЦикла;

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Для Каждого Сотрудник Из СотрудникиКЗаписи Цикл
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.бит_ВзысканияСотрудников");
			ЭлементБлокировки.УстановитьЗначение("Сотрудник", Сотрудник);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		КонецЦикла;
		Блокировка.Заблокировать();

		Для Каждого Сотрудник Из СотрудникиКЗаписи Цикл
			НаборЗаписей = РегистрыСведений.бит_ВзысканияСотрудников.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Сотрудник.Установить(Сотрудник);

			МаксимальныйНомер = 0;
			СтрокиСотрудника = ТаблицаВзысканий.НайтиСтроки(Новый Структура("Сотрудник", Сотрудник));
			Для Каждого СтрокаВзыскания Из СтрокиСотрудника Цикл
				МаксимальныйНомер = Макс(МаксимальныйНомер, СтрокаВзыскания.НомерПоПорядку);
			КонецЦикла;

			Для Каждого СтрокаВзыскания Из СтрокиСотрудника Цикл
				Запись = НаборЗаписей.Добавить();
				ЗаполнитьЗначенияСвойств(Запись, СтрокаВзыскания);
				Если Не ЗначениеЗаполнено(Запись.НомерПоПорядку) Тогда
					МаксимальныйНомер = МаксимальныйНомер + 1;
					Запись.НомерПоПорядку = МаксимальныйНомер;
				КонецЕсли;
			КонецЦикла;

			НаборЗаписей.Записать();
		КонецЦикла;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	ПрочитатьВзыскания();
	// --- 1 бит Балицкий В.В. 11.20.2026

КонецПроцедуры

#КонецОбласти
