#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// +++ 1 бит Балицкий В.В. 11.20.2026
	бит_ЗаписатьПриЗакрытии = Истина;
	бит_ФизическоеЛицо = Параметры.ФизическоеЛицо;

	Если Не ЗначениеЗаполнено(бит_ФизическоеЛицо) Тогда
		ТолькоПросмотр = Истина;
		Возврат;
	КонецЕсли;

	Если Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.НаградыФизическихЛиц) Тогда
		ТолькоПросмотр = Истина;
	КонецЕсли;

	НаборЗаписей = РегистрыСведений.НаградыФизическихЛиц.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ФизическоеЛицо.Установить(бит_ФизическоеЛицо);
	НаборЗаписей.Прочитать();
	ЗначениеВРеквизитФормы(НаборЗаписей, "Награды");
	// --- 1 бит Балицкий В.В. 11.20.2026

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	// +++ 1 бит Балицкий В.В. 11.20.2026
	Если ЗавершениеРаботы Или ТолькоПросмотр Или Не Модифицированность Или Не бит_ЗаписатьПриЗакрытии Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ЗаписатьНаградыНаСервере();
	Исключение
		Отказ = Истина;
		ВызватьИсключение;
	КонецПопытки;
	// --- 1 бит Балицкий В.В. 11.20.2026

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыНаграды

&НаКлиенте
Процедура НаградыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	// +++ 1 бит Балицкий В.В. 11.20.2026
	Если Не НоваяСтрока Тогда
		Возврат;
	КонецЕсли;

	ТекущиеДанные = Элемент.ТекущиеДанные;
	ТекущиеДанные.НомерПоПорядку = СледующийНомерНаграды();
	Модифицированность = Истина;
	// --- 1 бит Балицкий В.В. 11.20.2026

КонецПроцедуры

&НаКлиенте
Процедура НаградыПриИзменении(Элемент)

	// +++ 1 бит Балицкий В.В. 11.20.2026
	Модифицированность = Истина;
	// --- 1 бит Балицкий В.В. 11.20.2026

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)

	// +++ 1 бит Балицкий В.В. 11.20.2026
	бит_ЗаписатьПриЗакрытии = Истина;
	Закрыть();
	// --- 1 бит Балицкий В.В. 11.20.2026

КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)

	// +++ 1 бит Балицкий В.В. 11.20.2026
	Если ТолькоПросмотр Или Не Модифицированность Тогда
		Возврат;
	КонецЕсли;

	ЗаписатьНаградыНаСервере();
	Модифицированность = Ложь;
	// --- 1 бит Балицкий В.В. 11.20.2026

КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)

	// +++ 1 бит Балицкий В.В. 11.20.2026
	бит_ЗаписатьПриЗакрытии = Ложь;
	Модифицированность = Ложь;
	Закрыть();
	// --- 1 бит Балицкий В.В. 11.20.2026

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция СледующийНомерНаграды()

	// +++ 1 бит Балицкий В.В. 11.20.2026
	МаксимальныйНомер = 0;
	Для Каждого Запись Из Награды Цикл
		Если Запись.НомерПоПорядку > МаксимальныйНомер Тогда
			МаксимальныйНомер = Запись.НомерПоПорядку;
		КонецЕсли;
	КонецЦикла;

	Возврат МаксимальныйНомер + 1;
	// --- 1 бит Балицкий В.В. 11.20.2026

КонецФункции

&НаСервере
Процедура ЗаписатьНаградыНаСервере()

	// +++ 1 бит Балицкий В.В. 11.20.2026
	СтрокиФормы = РеквизитФормыВЗначение("Награды");
	НаборЗаписей = РегистрыСведений.НаградыФизическихЛиц.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ФизическоеЛицо.Установить(бит_ФизическоеЛицо);

	МаксимальныйНомер = 0;
	Для Каждого СтрокаФормы Из СтрокиФормы Цикл
		Если СтрокаФормы.НомерПоПорядку > МаксимальныйНомер Тогда
			МаксимальныйНомер = СтрокаФормы.НомерПоПорядку;
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаФормы Из СтрокиФормы Цикл
		Запись = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, СтрокаФормы);
		Запись.ФизическоеЛицо = бит_ФизическоеЛицо;
		Если Не ЗначениеЗаполнено(Запись.НомерПоПорядку) Тогда
			МаксимальныйНомер = МаксимальныйНомер + 1;
			Запись.НомерПоПорядку = МаксимальныйНомер;
		КонецЕсли;
	КонецЦикла;

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.НаградыФизическихЛиц");
		ЭлементБлокировки.УстановитьЗначение("ФизическоеЛицо", бит_ФизическоеЛицо);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		НаборЗаписей.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	ЗначениеВРеквизитФормы(НаборЗаписей, "Награды");
	Модифицированность = Ложь;
	// --- 1 бит Балицкий В.В. 11.20.2026

КонецПроцедуры

#КонецОбласти
