&НаСервере
Процедура бит_ЗаписатьВзысканияНаСервере()

	// +++ 1 бит Балицкий В.В. 11.20.2026
	ТаблицаВзысканий = РеквизитФормыВЗначение("бит_Взыскания");

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицоСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сотрудники.Ссылка КАК Сотрудник
	|ПОМЕСТИТЬ ВТ_Сотрудники
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.ФизическоеЛицо = &ФизическоеЛицо
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Сотрудник
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Сотрудники.Сотрудник КАК Сотрудник
	|ИЗ
	|	ВТ_Сотрудники КАК Сотрудники";

	СотрудникиКБлокировке = Новый Массив;
	ВыборкаСотрудников = Запрос.Выполнить().Выбрать();
	Пока ВыборкаСотрудников.Следующий() Цикл
		СотрудникиКБлокировке.Добавить(ВыборкаСотрудников.Сотрудник);
	КонецЦикла;

	Для Каждого СтрокаВзыскания Из ТаблицаВзысканий Цикл
		Если ЗначениеЗаполнено(СтрокаВзыскания.Сотрудник)
			И СотрудникиКБлокировке.Найти(СтрокаВзыскания.Сотрудник) = Неопределено Тогда
			СотрудникиКБлокировке.Добавить(СтрокаВзыскания.Сотрудник);
		КонецЕсли;
	КонецЦикла;

	НачатьТранзакцию();
	Попытка
		Если СотрудникиКБлокировке.Количество() > 0 Тогда
			Блокировка = Новый БлокировкаДанных;
			Для Каждого Сотрудник Из СотрудникиКБлокировке Цикл
				ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.бит_ВзысканияСотрудников");
				ЭлементБлокировки.УстановитьЗначение("Сотрудник", Сотрудник);
				ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			КонецЦикла;
			Блокировка.Заблокировать();
		КонецЕсли;

		ЗапросЗаписей = Новый Запрос;
		ЗапросЗаписей.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицоСсылка);
		ЗапросЗаписей.Текст =
		"ВЫБРАТЬ
		|	Взыскания.Сотрудник КАК Сотрудник,
		|	Взыскания.НомерПоПорядку КАК НомерПоПорядку
		|ИЗ
		|	РегистрСведений.бит_ВзысканияСотрудников КАК Взыскания
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
		|		ПО Взыскания.Сотрудник = Сотрудники.Ссылка
		|ГДЕ
		|	Сотрудники.ФизическоеЛицо = &ФизическоеЛицо";

		Существующие = Новый Соответствие;
		ВыборкаЗаписей = ЗапросЗаписей.Выполнить().Выбрать();
		Пока ВыборкаЗаписей.Следующий() Цикл
			ОписаниеЗаписи = Новый Структура("Сотрудник, НомерПоПорядку", ВыборкаЗаписей.Сотрудник, ВыборкаЗаписей.НомерПоПорядку);
			Существующие.Вставить(КлючЗаписиВзыскания(ВыборкаЗаписей.Сотрудник, ВыборкаЗаписей.НомерПоПорядку), ОписаниеЗаписи);
		КонецЦикла;

		Оставить = Новый Соответствие;
		Для Каждого СтрокаВзыскания Из ТаблицаВзысканий Цикл
			Оставить.Вставить(КлючЗаписиВзыскания(СтрокаВзыскания.Сотрудник, СтрокаВзыскания.НомерПоПорядку), Истина);
			МенеджерЗаписи = РегистрыСведений.бит_ВзысканияСотрудников.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтрокаВзыскания);
			МенеджерЗаписи.Записать();
		КонецЦикла;

		Для Каждого КлючИЗначение Из Существующие Цикл
			Если Оставить.Получить(КлючИЗначение.Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			МенеджерЗаписи = РегистрыСведений.бит_ВзысканияСотрудников.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Сотрудник = КлючИЗначение.Значение.Сотрудник;
			МенеджерЗаписи.НомерПоПорядку = КлючИЗначение.Значение.НомерПоПорядку;
			МенеджерЗаписи.Удалить();
		КонецЦикла;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	// --- 1 бит Балицкий В.В. 11.20.2026

КонецПроцедуры

&НаСервере
Процедура бит_ПрочитатьВзыскания()

	// +++ 1 бит Балицкий В.В. 11.20.2026
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицоСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Взыскания.Сотрудник КАК Сотрудник,
	|	Взыскания.НомерПоПорядку КАК НомерПоПорядку,
	|	Взыскания.ВидВзыскания КАК ВидВзыскания,
	|	Взыскания.Дата КАК Дата,
	|	Взыскания.НомерПриказа КАК НомерПриказа,
	|	Взыскания.ДатаПриказа КАК ДатаПриказа,
	|	Взыскания.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.бит_ВзысканияСотрудников КАК Взыскания
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
	|		ПО Взыскания.Сотрудник = Сотрудники.Ссылка
	|ГДЕ
	|	Сотрудники.ФизическоеЛицо = &ФизическоеЛицо
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сотрудник,
	|	НомерПоПорядку";

	ТаблицаВзысканий = Запрос.Выполнить().Выгрузить();
	ТаблицаВзысканий.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20)));
	Для Каждого СтрокаВзыскания Из ТаблицаВзысканий Цикл
		СтрокаВзыскания.Статус = СтатусВзыскания(СтрокаВзыскания.Дата, СтрокаВзыскания.ДатаПриказа);
	КонецЦикла;
	ЗначениеВРеквизитФормы(ТаблицаВзысканий, "бит_Взыскания");
	// --- 1 бит Балицкий В.В. 11.20.2026

