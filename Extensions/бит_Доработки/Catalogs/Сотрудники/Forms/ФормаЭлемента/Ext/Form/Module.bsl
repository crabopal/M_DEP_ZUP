&НаСервере
&После("ПриСозданииНаСервере")
Процедура бит_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// +++ 1 бит Балицкий В.В. 11.20.2026
	бит_ДобавитьГиперссылкиДополнительныхДанных();
	// --- 1 бит Балицкий В.В. 11.20.2026

КонецПроцедуры

