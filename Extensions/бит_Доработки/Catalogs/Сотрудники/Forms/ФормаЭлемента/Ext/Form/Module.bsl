&НаСервере
Процедура бит_ДобавитьГиперссылкиДополнительныхДанных()

	// +++ 1 бит Балицкий В.В. 11.20.2026
	ДоступныНаграды = ПолучитьФункциональнуюОпцию("ИспользоватьЛичныеДанныеВФормеСотрудника")
		И (РольДоступна("ДобавлениеИзменениеДанныхДляНачисленияЗарплатыРасширенная")
			Или РольДоступна("ДобавлениеИзменениеДанныхФизическихЛицЗарплатаКадрыРасширенная")
			Или РольДоступна("ПолныеПрава")
			Или РольДоступна("ЧтениеДанныхДляНачисленияЗарплатыРасширенная")
			Или РольДоступна("ЧтениеДанныхФизическихЛицЗарплатаКадрыРасширенная"));

	Если ДоступныНаграды Тогда
		бит_ДобавитьГиперссылку("бит_Награды", "Награды");
	КонецЕсли;

	Если РольДоступна("бит_КадровикВзыскания") Тогда
		бит_ДобавитьГиперссылку("бит_Взыскания", "Взыскания");
	КонецЕсли;
	// --- 1 бит Балицкий В.В. 11.20.2026

КонецПроцедуры

&НаСервере
Процедура бит_ДобавитьГиперссылку(ИмяКоманды, Заголовок)

	// +++ 1 бит Балицкий В.В. 11.20.2026
	Команда = Команды.Добавить(ИмяКоманды);
	Команда.Действие = ИмяКоманды;
	Команда.Заголовок = Заголовок;

	Кнопка = Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), Элементы.ГруппаДополнительныеДанные1);
	Кнопка.Вид = ВидКнопкиФормы.Гиперссылка;
	Кнопка.ИмяКоманды = ИмяКоманды;

	Если Элементы.Найти("Страхование") <> Неопределено Тогда
		Элементы.Переместить(Кнопка, Элементы.ГруппаДополнительныеДанные1, Элементы.Страхование);
	КонецЕсли;
	// --- 1 бит Балицкий В.В. 11.20.2026

КонецПроцедуры
